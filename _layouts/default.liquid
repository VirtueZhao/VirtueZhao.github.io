<!doctype html>
<html lang="{{ site.lang }}">
  <!-- Head -->
  <head>
    {% if page.redirect %}
      {% if page.redirect == true %}
        {% assign redirect = site.baseurl | append: '/' %}
      {% elsif page.redirect contains '://' %}
        {% assign redirect = page.redirect %}
      {% else %}
        {% assign redirect = page.redirect | relative_url %}
      {% endif %}
      <meta http-equiv="refresh" content="3; url={{ redirect }}">
    {% endif %}
    {% include head.liquid %}
    {% comment %}
      Local override of al_folio_core's _layouts/default.liquid (v1.0.11).
      Only change vs upstream: the <style> block below, injected after
      head.liquid (so it wins over main.css) to recolor the theme site-wide.
      SCSS/PurgeCSS could not reliably carry this override, so it lives here.
      Re-sync with the gem if you upgrade it.
    {% endcomment %}
    <style>
      :root {
        --global-theme-color: #0076df;
        --global-hover-color: #0076df;
      }
      html[data-theme="dark"] {
        --global-theme-color: #4c9ff2;
        --global-hover-color: #4c9ff2;
      }
      /* Publications: bold the highlighted (self) author; no italic, no underline.
         Match al-folio's own selector specificity so this wins. */
      .publications ol.bibliography li .author > em {
        font-weight: 700;
        font-style: normal;
        border-bottom: none;
      }
      /* Publications: hide the venue/date line (venue now shown on the left badge) */
      .publications .periodical {
        display: none;
      }
      /* Service: icon + aligned two-column list */
      .dz-service {
        display: grid;
        grid-template-columns: max-content 1fr;
        gap: 0.6rem 1.5rem;
        align-items: baseline;
        margin: 0.6rem 0 0;
      }
      .dz-service .dz-svc-label {
        display: inline-flex;
        align-items: baseline;
        gap: 0.5rem;
        font-weight: 700;
        color: var(--global-text-color);
        white-space: nowrap;
      }
      .dz-service .dz-svc-label i {
        color: var(--global-theme-color);
        width: 1.2rem;
        text-align: center;
        font-size: 0.95rem;
      }
      .dz-service .dz-svc-body {
        color: var(--global-text-color);
      }
      @media (max-width: 640px) {
        .dz-service {
          grid-template-columns: 1fr;
          gap: 0.1rem;
        }
        .dz-service .dz-svc-body {
          margin: 0 0 0.55rem 1.7rem;
        }
      }
    </style>
  </head>

  <!-- Body -->
  <body class="{% if site.navbar_fixed %}fixed-top-nav{% endif %} {% unless site.footer_fixed %}sticky-bottom-footer{% endunless %}">
    <!-- Header -->
    {% include header.liquid %}

    <!-- Content -->
    <div class="container mt-5" role="main">
      {% if page.toc and page.toc.sidebar %}
        {% assign toc_collapse = page.toc.collapse | default: 'expanded' %}
        {% assign toc_collapse_depth = page.toc.collapse_depth | default: '' %}
        {% if page.toc.sidebar == 'right' %}
          <div class="row">
            <!-- main content area -->
            <div class="col-sm-9">{{ content }}</div>
            <!-- sidebar, which will move to the top on a small screen -->
            <div class="col-sm-3">
              <nav
                id="toc-sidebar"
                class="sticky-top toc toc-sidebar"
                aria-label="Table of contents"
                data-toc-collapse="{{ toc_collapse }}"
                data-toc-collapse-depth="{{ toc_collapse_depth }}"
              ></nav>
            </div>
          </div>
        {% else %}
          <div class="row">
            <!-- sidebar, which will move to the top on a small screen -->
            <div class="col-sm-3">
              <nav
                id="toc-sidebar"
                class="sticky-top toc toc-sidebar"
                aria-label="Table of contents"
                data-toc-collapse="{{ toc_collapse }}"
                data-toc-collapse-depth="{{ toc_collapse_depth }}"
              ></nav>
            </div>
            <!-- main content area -->
            <div class="col-sm-9">{{ content }}</div>
          </div>
        {% endif %}
      {% else %}
        {{ content }}
      {% endif %}
    </div>

    <!-- Footer -->
    {% include footer.liquid %}

    <!-- JavaScripts -->
    {% include scripts.liquid %}
  </body>
</html>
